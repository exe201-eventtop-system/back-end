    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>99f2008e-9228-4639-9cf8-c1db4515cc66</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
