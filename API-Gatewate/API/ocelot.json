{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamHeaderTransform": {
        "Set-Cookie": "Copy"
      },
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5100
        }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "authService"
    },
    {
      "DownstreamPathTemplate": "/api/user/{everything}",
      "DownstreamHeaderTransform": {
        "Set-Cookie": "Copy"
      },
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5100
        }
      ],
      "UpstreamPathTemplate": "/user/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "authService"
    },
    {
      "DownstreamPathTemplate": "/api/suppliers/{everything}",
      "DownstreamHeaderTransform": {
        "Set-Cookie": "Copy"
      },
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5100
        }
      ],
      "UpstreamPathTemplate": "/suppliers/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "authService"
    },
    {
      "DownstreamPathTemplate": "/api/planning/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5200
        }
      ],
      "UpstreamPathTemplate": "/planning/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "RouteClaimsRequirement": {
        "Role": "Customer"
      },
      "SwaggerKey": "planningService"
    },
    {
      "DownstreamPathTemplate": "/api/services/{everything}",
      "DownstreamHeaderTransform": {
        "Set-Cookie": "Copy"
      },
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5300
        }
      ],
      "UpstreamPathTemplate": "/services/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "productService",
      "UpstreamHeaderTransform": {
        "Cookie": "Copy"
      }
    },
    {
      "DownstreamPathTemplate": "/api/cart/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5500
        }
      ],
      "UpstreamPathTemplate": "/cart/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "cartService"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "planningService",
      "Config": [
        {
          "Name": "Planning Service API",
          "Version": "v1",
          "Url": "http://localhost:5200/v3/api-docs"
        }
      ]
    },
    {
      "Key": "cartService",
      "Config": [
        {
          "Name": "Cart Service API",
          "Version": "v1",
          "Url": "https://localhost:5500/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "authService",
      "Config": [
        {
          "Name": "Auth Service API",
          "Version": "v1",
          "Url": "https://localhost:5100/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "productService",
      "Config": [
        {
          "Name": "Product Service API",
          "Version": "v1",
          "Url": "https://localhost:5300/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}
